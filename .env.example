# QR Studio environment variables. Copy to .env.local (git-ignored) and fill in real values.
# Never commit real secrets. Only NEXT_PUBLIC_* values are sent to the browser.

# Public canonical URL of the site. Used for metadata and for links in auth emails
# (verification and password reset redirect to <NEXT_PUBLIC_SITE_URL>/auth/callback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (accounts: login, dashboard, saved projects, history, synced templates) ---
# Optional: when these are not set, QR Studio runs without accounts and everything else works.
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…) or the legacy "anon" key. NEVER a secret/service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Server/tooling only (not used by the app at runtime; never prefix with NEXT_PUBLIC_) ---
# Only needed if you run migrations with a tool that connects directly to Postgres.
# DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres
