{
  "browser": { "mode": "launch", "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" },
  "start_url": { "url": "https://www.qrcode-monkey.com/" },
  "environment": { "viewport": { "width": 1440, "height": 900 } },
  "actions": [ { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 6000 } ],
  "capture": {
    "at_end": ["dom", "accessibility", "screenshot", "url"],
    "events": ["network", "console", "page-errors"],
    "network": { "response_body": true, "request_body": true },
    "limits": { "max_network_body_bytes": 16777216, "max_network_body_allocation_bytes": 67108864, "max_event_allocation_bytes": 67108864, "max_total_event_allocation_bytes": 536870912 }
  }
}
