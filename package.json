{
  "name": "qr-studio",
  "version": "0.1.0",
  "private": true,
  "description": "QR Studio — an original, client-side QR code generator with live preview, design controls, logo processing and real PNG/SVG/PDF/EPS export.",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "lucide-react": "^1.67.0",
    "next": "^16.4.5",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.14",
    "zod": "^4.6.7",
    "zustand": "^5.0.16",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.5.438",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9",
    "vitest": "^5.1.0",
    "write-excel-file": "^4.1.1"
  },
  "type": "module"
}
